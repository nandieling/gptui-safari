{
  "manifest_version": 2,
  "name": "gpt-ui",
  "version": "0.1.0",
  "description": "A focused modern theme for NexusPHP-based PT sites in macOS Safari.",
  "icons": {
    "16": "icon-16.png",
    "32": "icon-32.png",
    "48": "icon-48.png",
    "128": "icon-128.png"
  },
  "permissions": [
    "storage"
  ],
  "content_scripts": [
    {
      "matches": [
        "<all_urls>"
      ],
      "js": [
        "domain-utils.js",
        "target-domains.js",
        "themes.js",
        "content.js"
      ],
      "run_at": "document_start",
      "all_frames": true
    }
  ],
  "browser_action": {
    "default_title": "gpt-ui",
    "default_icon": {
      "16": "icon-16.png",
      "32": "icon-32.png",
      "48": "icon-48.png",
      "128": "icon-128.png"
    },
    "default_popup": "options.html"
  },
  "options_ui": {
    "page": "options.html",
    "open_in_tab": true
  },
  "web_accessible_resources": [
    "theme.css",
    "agsv-theme.css",
    "safari-compat.css",
    "site-colors.css"
  ]
}
